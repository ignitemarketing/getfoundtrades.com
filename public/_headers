# Response headers for Cloudflare Workers static assets (wrangler.jsonc assets.directory = ./dist).
# Astro content-hashes every emitted file under /_astro/, so a URL's bytes never change
# under it: cache those for a year and skip revalidation entirely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable-name files keep their URL across releases, so give them a day of freshness
# instead of the default max-age=0, must-revalidate. HTML, robots.txt and sitemaps
# deliberately keep the default.
/og.png
  Cache-Control: public, max-age=86400

/og.svg
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# Security headers for every response (Refs #8). Inventory the policy rests on: CSS is inlined
# into <style> (astro.config.mjs inlineStylesheets) and index.astro uses style attributes, so
# styles need 'unsafe-inline'; fonts, images and the waitlist module script are all same-origin
# (assetsInlineLimit: 0 keeps the script an external /_astro/ file so script-src stays 'self').
# The JSON-LD <script type="application/ld+json"> is a data block and is not subject to script-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
