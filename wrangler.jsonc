{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getfoundtrades",
  "compatibility_date": "2026-07-01",
  // Serve only on getfoundtrades.com: no <name>.workers.dev host or preview URLs to duplicate it.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
