---
import Base from '../layouts/Base.astro';
import { content as c } from '../content';
---
<Base path="/404" title={`Page not found | ${c.brand}`} noindex>
  <header class="hdr">
    <div class="wrap hdr-inner">
      <a class="brand" href="/" aria-label={`${c.brand} home`}>{c.brand}</a>
      <a class="hdr-cta" href="/#waitlist">{c.navCta}</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-copy">
        <h1>Page not found</h1>
        <p class="hero-sub">That link is mistyped or out of date. Head back to the home page, or join the waitlist.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/">Back to home</a>
          <a class="btn btn-ghost" href="/#waitlist">{c.navCta}</a>
        </div>
      </div>
    </section>
  </main>
</Base>
